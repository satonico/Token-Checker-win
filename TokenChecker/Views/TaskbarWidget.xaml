<Window x:Class="TokenChecker.Views.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:TokenChecker.Controls"
        Title="Token Checker Widget"
        Width="118"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">

    <!--
        タスクバーと同じ高さで隣接して表示。
        AllowsTransparency=True で完全透明 → タスクバーに溶け込んで見える。
    -->
    <Border x:Name="Root"
            CornerRadius="6"
            Cursor="Hand"
            MouseLeftButtonDown="Root_Click">

        <!-- 普段は透明でタスクバーに溶け込み、マウスオーバー時のみ薄く強調 -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#26FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
        <StackPanel x:Name="WideContent" Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="6,0">

            <!-- Claude -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="20" Height="20" Margin="0,0,4,0">
                    <ctrl:DonutChart x:Name="ClaudeDonut"/>
                    <TextBlock Text="✦" Foreground="#F0F0F0" FontSize="7"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="ClaudeLabel"
                           Text="--%"
                           Foreground="#F0F0F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 区切り線 -->
            <Rectangle Width="1" Height="16"
                       Fill="#40FFFFFF"
                       Margin="6,0"/>

            <!-- Codex -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="20" Height="20" Margin="0,0,4,0">
                    <ctrl:DonutChart x:Name="CodexDonut"/>
                    <TextBlock Text="▶" Foreground="#F0F0F0" FontSize="7"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="CodexLabel"
                           Text="--%"
                           Foreground="#F0F0F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>

        <StackPanel x:Name="CompactContent"
                    Visibility="Collapsed"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="4,0">
            <Grid Width="16" Height="16" Margin="0,0,2,0">
                <ctrl:DonutChart x:Name="CompactClaudeDonut"/>
                <TextBlock Text="✦" Foreground="#F0F0F0" FontSize="6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="CompactClaudeLabel"
                       Text="--" Foreground="#F0F0F0"
                       FontSize="12" FontWeight="SemiBold"/>
            <Rectangle Width="1" Height="14" Fill="#40FFFFFF" Margin="3,0"/>
            <Grid Width="16" Height="16" Margin="0,0,2,0">
                <ctrl:DonutChart x:Name="CompactCodexDonut"/>
                <TextBlock Text="▶" Foreground="#F0F0F0" FontSize="6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="CompactCodexLabel"
                       Text="--" Foreground="#F0F0F0"
                       FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel x:Name="VerticalContent"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Grid Width="14" Height="14" Margin="0,0,2,0">
                    <ctrl:DonutChart x:Name="VerticalClaudeDonut"/>
                    <TextBlock Text="✦" Foreground="#F0F0F0" FontSize="5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="VerticalClaudeLabel"
                           Text="--" Foreground="#F0F0F0"
                           FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Grid Width="14" Height="14" Margin="0,0,2,0">
                    <ctrl:DonutChart x:Name="VerticalCodexDonut"/>
                    <TextBlock Text="▶" Foreground="#F0F0F0" FontSize="5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="VerticalCodexLabel"
                           Text="--" Foreground="#F0F0F0"
                           FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        </Grid>
    </Border>
</Window>
